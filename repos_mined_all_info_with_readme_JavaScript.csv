Import and register the component in main.js
```js
import Vue from 'vue'
import Vue2SfcTemplate from 'vue2-sfc-template'

Vue.use(Vue2SfcTemplate)
```

### Manual Import
```js
import Vue2SfcTemplate from 'vue2-sfc-template'

export default {
    components: {
